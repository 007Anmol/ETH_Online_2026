# Server-only. Never prefix the service role with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. 16-byte hex. Falls back to the demo key in lib/constants.ts
NFC_MASTER_KEY=00112233445566778899aabbccddeeff

# Hedera testnet operator — server-only. Never prefix with NEXT_PUBLIC_.
# Private key stays in .env.local (gitignored). Do not paste a real key here.
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
HEDERA_TESTNET_CHAIN_ID=296
HEDERA_OPERATOR_PRIVATE_KEY=
HEDERA_OPERATOR_ADDRESS=
HEDERA_OPERATOR_ACCOUNT_ID=
# Frozen Hedera testnet registry. Do not redeploy for app writes.
HEDERA_REGISTRY_ADDRESS=0xd01d7972cD8B14B28b61e1e4709227923A3b464b
HEDERA_REGISTRY_CONTRACT_ID=0.0.10394090
HEDERA_REGISTRY_HASHSCAN_URL=https://hashscan.io/testnet/contract/0.0.10394090

# Privy server authentication. Keep this secret server-only.
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# World ID authentication.
NEXT_PUBLIC_WORLD_ID_APP_ID=app_
NEXT_PUBLIC_WORLD_ID_ACTION=
WORLD_ID_ACTION=
WORLD_ID_RP_ID=
WORLD_ID_SIGNING_KEY=

