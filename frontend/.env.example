# Server-only. Never prefix the service role with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. 16-byte hex. Falls back to the demo key in lib/constants.ts
NFC_MASTER_KEY=00112233445566778899aabbccddeeff

# Hedera testnet operator — server-only. Never prefix with NEXT_PUBLIC_.
# Private key stays in .env.local (gitignored). Do not paste a real key here.
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
HEDERA_TESTNET_CHAIN_ID=296
HEDERA_OPERATOR_PRIVATE_KEY=
HEDERA_OPERATOR_ADDRESS=
HEDERA_OPERATOR_ACCOUNT_ID=
